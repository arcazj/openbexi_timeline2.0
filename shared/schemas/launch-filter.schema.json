{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbexi.local/schemas/launch-filter.schema.json",
  "title": "Portable launch filter",
  "type": "object", "additionalProperties": false, "required": ["version", "name", "source_ids"],
  "properties": {
    "version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "source_ids": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"}},
    "group_by": {"type": "string", "minLength": 1, "maxLength": 256},
    "expression": {"type": ["object", "null"]},
    "search": {"type": "object", "additionalProperties": false, "properties": {
      "text": {"type": "string", "maxLength": 512}, "mode": {"enum": ["any", "all", "phrase", "regex"]},
      "caseSensitive": {"type": "boolean"}, "fields": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "maxLength": 256}},
      "flags": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"enum": ["i", "m", "s"]}},
      "matchMode": {"enum": ["search", "full"]}, "dialect": {"const": "re2-common-v1"}
    }},
    "initial_range": {"oneOf": [{"const": "current_time"}, {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string", "format": "timeline-instant"}, "to": {"type": "string", "format": "timeline-instant"}}}]}
  }
}
